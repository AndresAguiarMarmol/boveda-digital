# ==============================================================================
# BÓVEDA DIGITAL — Variables de Entorno y Configuración SMTP de Correo
# ==============================================================================

# Puerto local del servidor (por defecto 3000)
PORT=3000

# Clave secreta para firma de tokens JWT
JWT_SECRET=boveda_digital_secret_key_halterofilia_2026

# ------------------------------------------------------------------------------
# Configuración SMTP para Envío Real de Códigos de Validación (Gmail)
# ------------------------------------------------------------------------------
# Instrucciones para Gmail:
# 1. Ingresa a tu Cuenta de Google (myaccount.google.com).
# 2. Ve a 'Seguridad' y asegúrate de tener activada la 'Verificación en dos pasos'.
# 3. En el buscador escribe 'Contraseñas de aplicaciones' (o ve a Seguridad > Contraseñas de aplicaciones).
# 4. Crea una contraseña con el nombre 'Boveda Digital'.
# 5. Google te mostrará una contraseña de 16 letras (ej: abcd efgh ijkl mnop).
# 6. Pégala abajo en SMTP_PASS (puedes incluirla con o sin espacios, el sistema la sanitiza).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-16-caracteres
SMTP_FROM=tu-correo@gmail.com
